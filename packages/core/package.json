{
  "name": "@alaikis/alaidesign-ui",
  "version": "0.3.1",
  "description": "AlaiDesign Web Components core (framework-agnostic, compiled from Svelte source, self-contained Tailwind CSS)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/alaidesign.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": "./dist/components/*.js",
    "./alaidesign.css": "./dist/alaidesign.css",
    "./components.css": "./dist/components/alaidesign.css",
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build-wc.mjs && node scripts/copy-assets.mjs && node scripts/build-css.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide": "^0.460.0",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/cli": "^4.3.5",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^25.0.0",
    "svelte": "^5.59.1",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
