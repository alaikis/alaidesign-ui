{
  "name": "@alaikis/alaidesign",
  "version": "0.2.1",
  "description": "AlaiDesign — 高能量 Svelte 5 组件库",
  "type": "module",
  "workspaces": ["packages/*"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaikis/alai-desgin.git"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "design-system",
    "component-library",
    "ui",
    "web-components",
    "high-energy"
  ],
  "license": "MIT",
  "svelte": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "svelte": "./dist/components/ui/*/index.js",
      "default": "./dist/components/ui/*/index.js"
    },
    "./components/ui/*/*.svelte": {
      "svelte": "./dist/components/ui/*/*.svelte",
      "default": "./dist/components/ui/*/*.svelte"
    },
    "./components/ui/*/*.ts": {
      "default": "./dist/components/ui/*/*.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "svelte-package && node -e \"require('fs').copyFileSync('src/tokens.css','dist/tokens.css');require('fs').copyFileSync('src/styles.css','dist/styles.css');\"",
    "check": "svelte-check",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@iconify/svelte": "^5.1.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.33.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "svelte": "^5.46.1",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
